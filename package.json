{
  "name": "officeview",
  "version": "0.4.0",
  "description": "React components that render Office documents (Word, PowerPoint, Excel) on <canvas> \u2014 pixel-faithful, not HTML translation. Works on desktop and mobile.",
  "keywords": [
    "react",
    "canvas",
    "docx",
    "xlsx",
    "pptx",
    "office-documents",
    "ooxml"
  ],
  "homepage": "https://github.com/julianshen/officeview",
  "bugs": {
    "url": "https://github.com/julianshen/officeview/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianshen/officeview.git"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/worker-entry.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.18",
    "canvas": "^3.2.3",
    "jsdom": "^29.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "private": true
}
