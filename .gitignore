node_modules/
dist/
coverage/
*.log
.DS_Store
# ignore the corpus binaries (they are fetched, not vendored) …
# …but keep the SHA lockfile, the integrity record of what we actually tested.
# Note: must be `corpus/*`, not `corpus/` — git cannot re-include a file whose
# parent directory is itself excluded.
corpus/*
!corpus/corpus.lock.json
