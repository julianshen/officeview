{
  "name": "officeview",
  "version": "0.10.0",
  "description": "React components that render Office documents (Word, PowerPoint, Excel) on <canvas> \u2014 pixel-faithful, not HTML translation. Works on desktop and mobile.",
  "keywords": [
    "react",
    "canvas",
    "docx",
    "xlsx",
    "pptx",
    "office-documents",
    "ooxml"
  ],
  "homepage": "https://github.com/julianshen/officeview",
  "bugs": {
    "url": "https://github.com/julianshen/officeview/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianshen/officeview.git"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/worker.js",
    "*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core-entry.d.ts",
      "import": "./dist/core.js"
    },
    "./worker": {
      "types": "./dist/worker/office-worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.core.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --config playwright.viewer.config.ts",
    "test:browser:stream": "playwright test --config playwright.viewer.config.ts --project stream",
    "bench:viewer": "bun scripts/bench-interactive-viewer.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "site:samples": "bun scripts/build-site-samples.ts",
    "site:dev": "bun run site:samples && vite --config vite.site.config.ts",
    "site:build": "bun run site:samples && vite build --config vite.site.config.ts",
    "site:typecheck": "tsc -p site/tsconfig.json",
    "s0:test": "vitest run --config vitest.stream-s0.config.ts",
    "s0:test:napi": "vitest run --config vitest.stream-s0-napi.config.ts",
    "s0:report": "bun scripts/stream-s0/report.ts",
    "s0:napi": "bun --preload ./scripts/stream-s0/napi-preload.ts",
    "gates:core": "OV_MODULE_MAP=1 bun run build && bun scripts/core-gates.ts",
    "test:server": "cd server && bun test",
    "stream:demo": "bun --preload ./scripts/stream-s0/napi-preload.ts server/src/main.ts --demo --doc-dir corpus"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "motion": "14.4.0",
    "pako": "1.0.11"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.18",
    "canvas": "^3.2.3",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
